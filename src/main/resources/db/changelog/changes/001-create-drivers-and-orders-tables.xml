<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="jack.sparrow">
        <createTable tableName="drivers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="latitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="longitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="available" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="completed_deliveries" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="orders">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="restaurant_latitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="restaurant_longitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="customer_latitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="customer_longitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="driver_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="driver_id"
                                 constraintName="fk_orders_driver"
                                 referencedTableName="drivers" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
